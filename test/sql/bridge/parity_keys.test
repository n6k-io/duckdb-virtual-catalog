# name: test/sql/bridge/parity_keys.test
# description: asserting and verifying a key the source does not declare.
# group: [bridge]

require vcatbridge

statement ok
CREATE TABLE memory.main.nopk(x INTEGER, y VARCHAR);

statement ok
INSERT INTO memory.main.nopk VALUES (1,'a'), (2,'b');

statement ok
CREATE TABLE memory.main.dupes(x INTEGER, y VARCHAR);

statement ok
INSERT INTO memory.main.dupes VALUES (1,'a'), (1,'b');

statement ok
SELECT vcatbridge_register_source('v2_parity_keys', 'memory', 'tok_parity_keys');

statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'select', 'true');

statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'delete', 'true');

statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.dupes', 'select', 'true');

statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.dupes', 'delete', 'true');

# A key must name real columns of the table.
statement error
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'primary_key', ['nosuch']);
----
is not a column of

statement error
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'primary_key', []);
----
cannot be empty

# A key may be set before the grant that uses it. A key for a table nobody grants is never installed.
statement error
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.ungranted', 'primary_key', ['x']);
----
not found in catalog

statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'primary_key', ['x']);

# The key can also be derived by a query against the source.
statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.dupes', 'primary_key', {'columns_from_query': 'SELECT ''x'''});

# A check that returns rows means the declared key is not unique.
statement error
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.dupes', 'primary_key', {'columns_from_query': 'SELECT ''x''', 'verify_unique': 'SELECT x FROM memory.main.dupes GROUP BY x HAVING count(*) > 1'});
----
is not unique on the source

# A check that returns nothing proves it.
statement ok
SELECT vcatbridge_set_policy('v2_parity_keys', 'main.nopk', 'primary_key', {'columns': ['x'], 'verify_unique': 'SELECT x FROM memory.main.nopk GROUP BY x HAVING count(*) > 1'});

statement ok
ATTACH '' AS k (TYPE vcatbridge, ID 'v2_parity_keys', TOKEN 'tok_parity_keys');

# The asserted key is what the catalog reports and what a delete addresses rows by.
query II
SELECT name, primary_key FROM vcatbridge_table_permissions('k') ORDER BY name;
----
dupes	[x]
nopk	[x]

statement ok
DELETE FROM k.main.nopk WHERE x = 1;

query I
SELECT count(*) FROM memory.main.nopk;
----
1

# The key on `dupes` is a lie, and the write path is what catches it: two source rows for one key.
statement error
DELETE FROM k.main.dupes WHERE x = 1;
----
is not unique on the source

statement ok
DETACH k;
