# name: test/sql/bridge/parity_lifecycle.test
# description: schema recreate, a refused attach, and re-attaching a catalog.
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
SELECT bridge_register_source('v2_recv_a', 'memory', 'tok_recv_a');

statement ok
SELECT bridge_policy('v2_recv_a', 'main.users', 'select', 'true');

# ---------------------------------------------------------------------------
# An attach refused by token validation leaves the pending source spendable.
# ---------------------------------------------------------------------------

statement error
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'v2_recv_a', TOKEN 'wrong');
----
invalid setup token

statement error
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'never_registered', TOKEN 'tok_recv_a');
----
no registered source

statement ok
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'v2_recv_a', TOKEN 'tok_recv_a');

query I
SELECT count(*) FROM ws.main.users;
----
0

# The token was spent by the attach that redeemed it.
statement error
ATTACH '' AS ws2 (TYPE virtual_catalog_bridge, ID 'v2_recv_a', TOKEN 'tok_recv_a');
----
no registered source

# ---------------------------------------------------------------------------
# A dropped and recreated schema must not leave a wrapper bound to the dropped entry.
# ---------------------------------------------------------------------------

statement ok
CREATE SCHEMA ws.s;

statement ok
CREATE TABLE ws.s.t(x INTEGER);

statement ok
INSERT INTO ws.s.t VALUES (1);

statement ok
DROP SCHEMA ws.s CASCADE;

statement ok
CREATE SCHEMA ws.s;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'ws' AND schema_name = 's';
----
0

statement ok
CREATE TABLE ws.s.t(y VARCHAR);

statement ok
INSERT INTO ws.s.t VALUES ('new');

query I
SELECT y FROM ws.s.t;
----
new

# A schema the bridge serves cannot be dropped out from under it.
statement error
DROP SCHEMA ws.main CASCADE;
----
is serving a bridge

# ---------------------------------------------------------------------------
# DETACH releases the source, and a fresh one can take the catalog name.
# ---------------------------------------------------------------------------

statement ok
DETACH ws;

statement error
SELECT * FROM ws.main.users;
----
<REGEX>:.*(no source|does not exist).*

statement ok
SELECT bridge_register_source('v2_recv_c', 'memory', 'tok_recv_c');

statement ok
SELECT bridge_policy('v2_recv_c', 'main.users', 'select', 'true');

statement ok
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'v2_recv_c', TOKEN 'tok_recv_c');

query I
SELECT count(*) FROM ws.main.users;
----
0
