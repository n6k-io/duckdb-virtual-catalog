# name: test/sql/bridge/transaction.test
# description: the source resolves with the target's transaction.
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.orders(id INTEGER PRIMARY KEY, name VARCHAR, amt INTEGER);

statement ok
INSERT INTO memory.main.orders VALUES (1,'ada',50);

statement ok
SELECT bridge_register_source('v2_transaction', 'memory', 'tok_transaction');

statement ok
SELECT bridge_policy('v2_transaction', 'main.orders', 'select', 'true');

statement ok
SELECT bridge_policy('v2_transaction', 'main.orders', 'insert', 'true', 'true');

statement ok
SELECT bridge_policy('v2_transaction', 'main.orders', 'update', 'true');

statement ok
SELECT bridge_policy('v2_transaction', 'main.orders', 'delete', 'true');

statement ok
ATTACH '' AS b (TYPE virtual_catalog_bridge, ID 'v2_transaction', TOKEN 'tok_transaction');

# A statement outside an explicit transaction is a transaction of its own, and commits with it.
statement ok
INSERT INTO b.main.orders VALUES (2,'grace',150);

query I
SELECT count(*) FROM memory.main.orders;
----
2

# A rollback undoes the source's half too.
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO b.main.orders VALUES (3,'alan',250);

# Read-after-write inside one transaction sees the write.
query I
SELECT count(*) FROM b.main.orders;
----
3

statement ok
ROLLBACK;

query I
SELECT count(*) FROM memory.main.orders;
----
2

query I
SELECT count(*) FROM b.main.orders;
----
2

# And a commit keeps it.
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO b.main.orders VALUES (4,'edsger',350);

statement ok
UPDATE b.main.orders SET amt = 1 WHERE id = 1;

statement ok
COMMIT;

query II
SELECT id, amt FROM memory.main.orders ORDER BY id;
----
1	1
2	150
4	350

# Several writes in one transaction are one change: a rollback after both undoes both.
statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM b.main.orders WHERE id = 2;

statement ok
INSERT INTO b.main.orders VALUES (5,'hoare',500);

statement ok
ROLLBACK;

query I
SELECT id FROM memory.main.orders ORDER BY id;
----
1
2
4
