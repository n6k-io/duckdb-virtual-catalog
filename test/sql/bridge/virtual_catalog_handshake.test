# name: test/sql/bridge/virtual_catalog_handshake.test
# description: bridge handshake -- validation, token rules, and registry lifecycle
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO memory.main.users VALUES (1, 'a'), (2, 'b');

statement ok
CREATE TABLE memory.main.nopk(x INTEGER, y VARCHAR);

# ---------------------------------------------------------------------------
# bridge_register_source only mints a token; bridge_policy is what validates,
# one (table, verb) at a time, on the source connection.
# ---------------------------------------------------------------------------

statement ok
SELECT bridge_register_source('v1', 'memory', 'tok_v1');

# One pending source per id; the id is claimed from registration, not from setup.
statement error
SELECT bridge_register_source('v1', 'memory');
----
a source is already registered for bridge

statement error
SELECT bridge_policy('v1', 'users', 'select', 'true');
----
must be schema-qualified as 'schema.table'

statement error
SELECT bridge_policy('v1', 'shop.main.users', 'select', 'true');
----
must name a schema and a table

statement error
SELECT bridge_policy('v1', '.users', 'select', 'true');
----
has an empty schema or table name

statement error
SELECT bridge_policy('v1', 'main.users', 'write', 'true');
----
invalid verb 'write'

statement error
SELECT bridge_policy('v1', 'main.ghost', 'select', 'true');
----
not found in catalog 'memory' on source

# A schema the source does not have resolves no differently from a table it does not have.
statement error
SELECT bridge_policy('v1', 'nosuchschema.users', 'select', 'true');
----
not found in catalog 'memory' on source

statement error
SELECT bridge_policy('unregistered', 'main.users', 'select', 'true');
----
no registered source for bridge

# --- predicate validation ---------------------------------------------------
# The predicate is compiled against the source table it will be grafted onto.

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'nosuchcol = 1');
----
is not a valid WHERE clause on the source

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'count(*) > 0');
----
is not a valid WHERE clause on the source

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'row_number() over () = 1');
----
is not a valid WHERE clause on the source

statement error
SELECT bridge_policy('v1', 'main.users', 'select', '1, 2');
----
must be a single expression

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'id = $1');
----
may not contain parameters

# A WHERE clause would coerce all three of these, and the policy would then be stored as something
# that is not a predicate at all. The predicate is projected and type-checked instead.
statement error
SELECT bridge_policy('v1', 'main.users', 'select', '42');
----
must be BOOLEAN, but it is INTEGER

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'name');
----
must be BOOLEAN, but it is VARCHAR

statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'NULL');
----
must be BOOLEAN

# INSERT is appended through DuckDB's Appender, which has no WHERE to graft onto. It takes the
# grant, not a restriction.
statement error
SELECT bridge_policy('v1', 'main.users', 'insert', 'id > 0');
----
must be literally 'true'

statement error
SELECT bridge_policy('v1', 'main.users', 'alter', 'true');
----
invalid verb 'alter'

# --- the WITH CHECK half ----------------------------------------------------
# An insert's USING predicate cannot restrict rows, so its WITH CHECK is the only limit on what it
# may write. Silence would be an open boundary, so the grant has to say which it means.
statement error
SELECT bridge_policy('v1', 'main.users', 'insert', 'true');
----
must state a WITH CHECK predicate

# 'true' is the opt-out, spelled out.
statement ok
SELECT bridge_policy('v1', 'main.users', 'insert', 'true', 'true');

# SELECT and DELETE write no row, so there is nothing for a check to constrain.
statement error
SELECT bridge_policy('v1', 'main.users', 'delete', 'true', 'id > 0');
----
only supported for 'insert' and 'update'

# A check is validated against the source the same way a USING predicate is.
statement error
SELECT bridge_policy('v1', 'main.users', 'update', 'true', 'nosuchcolumn > 0');
----
is not a valid WHERE clause on the source

statement ok
SELECT bridge_policy('v1', 'main.users', 'select', 'id > 0');

# One policy per (table, verb): grants accumulate, they do not overwrite.
statement error
SELECT bridge_policy('v1', 'main.users', 'select', 'true');
----
a 'select' policy is already defined

# --- primary keys -----------------------------------------------------------
# Discovery runs on the first grant for a table. A key that discovery cannot find may still be
# supplied afterwards; it is the write that refuses without one.

statement ok
SELECT bridge_policy('v1', 'main.nopk', 'select', 'true');

statement ok
SELECT bridge_policy('v1', 'main.nopk', 'update', 'true');

statement error
SELECT bridge_primary_key('v1', 'main.nopk', []::VARCHAR[]);
----
cannot be empty

statement ok
SELECT bridge_primary_key('v1', 'main.nopk', ['x']);

# --- caller-supplied key discovery and validation ---------------------------

statement ok
CREATE TABLE memory.main.dupkey(k INTEGER, v VARCHAR);

statement ok
INSERT INTO memory.main.dupkey VALUES (1, 'a'), (1, 'b'), (2, 'c');

statement ok
SELECT bridge_policy('v1', 'main.dupkey', 'select', 'true');

statement error
SELECT bridge_primary_key_query('v1', 'shop.main.dupkey', 'SELECT ''k''');
----
must name a schema and a table

statement error
SELECT bridge_primary_key_query('v1', 'main.dupkey', 'SELECT k FROM memory.main.dupkey WHERE false');
----
returned no columns

statement error
SELECT bridge_primary_key_query('v1', 'main.dupkey', 'SELECT * FROM memory.main.no_such_table');
----
primary key query for table 'main.dupkey'

statement error
SELECT bridge_primary_key_query('v1', 'main.dupkey', 'SELECT NULL');
----
empty or NULL

statement ok
SELECT bridge_primary_key_query('v1', 'main.dupkey', 'SELECT ''k''');

statement ok
SELECT bridge_policy('v1', 'main.dupkey', 'delete', 'true');

statement error
SELECT bridge_primary_key_check('v1', 'shop.main.dupkey', 'SELECT 1 WHERE false');
----
must name a schema and a table

statement error
SELECT bridge_primary_key_check('v1', 'main.ungranted_table', 'SELECT 1 WHERE false');
----
no primary key is set

statement error
SELECT bridge_primary_key_check('v1', 'main.dupkey', 'SELECT k FROM memory.main.dupkey GROUP BY k HAVING count(*) > 1');
----
is not unique on the source

statement error
SELECT bridge_primary_key_check('v1', 'main.dupkey', 'SELECT * FROM memory.main.no_such_table');
----
primary key check for table 'main.dupkey'

query T
SELECT bridge_primary_key_check('v1', 'main.users', 'SELECT id FROM memory.main.users GROUP BY id HAVING count(*) > 1');
----
ok

# --- freeze-time validation -------------------------------------------------
# Both checks run before the pending source is consumed, so a rejected attach can be fixed with
# another bridge_policy call and retried with the SAME token.

statement ok
SELECT bridge_register_source('v_empty', 'memory', 'tok_empty');

statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'v_empty', TOKEN 'tok_empty');
----
has no policies

statement ok
SELECT bridge_policy('v_empty', 'main.users', 'delete', 'true');

# UPDATE and DELETE are driven by a scan of the table, so they cannot be granted without select.
statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'v_empty', TOKEN 'tok_empty');
----
without 'select'

statement ok
SELECT bridge_policy('v_empty', 'main.users', 'select', 'true');

# Same token, still live: neither rejection consumed the pending source.
statement ok
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'v_empty', TOKEN 'tok_empty');

statement ok
DETACH hs;

# ---------------------------------------------------------------------------
# The attach validates its options, then the token.
# ---------------------------------------------------------------------------

statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, TOKEN 'anything');
----
requires a 'id' option

statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'v7');
----
requires a 'token' option

# The nonce prefix is unique to the loaded extension binary, so a generated token minted elsewhere is
# refused before the id is even looked up.
statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'v7', TOKEN '00000000-0000-0000-0000-000000000000:deadbeef');
----
different copies of the virtual_catalog extension

statement ok
SELECT bridge_register_source('hs_b', 'memory', 'tok_hs_b');

statement ok
SELECT bridge_policy('hs_b', 'main.users', v, 'true', c) FROM (VALUES ('select', NULL), ('insert', 'true'), ('update', NULL), ('delete', NULL)) _(v, c);

# The token is checked against the pending source's own.
statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'hs_b', TOKEN 'tok_hs_wrong');
----
invalid setup token

# A valid token is still no use against an id nobody registered.
statement error
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'never_registered', TOKEN 'tok_hs_b');
----
no registered source for bridge

# None of the refusals consumed hs_b's pending source: its original token still works.
statement ok
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'hs_b', TOKEN 'tok_hs_b');

query IT
SELECT * FROM hs.main.users ORDER BY id;
----
1	a
2	b

# ---------------------------------------------------------------------------
# One ATTACH is one bridge; DETACH is the only teardown.
# ---------------------------------------------------------------------------

statement ok
DETACH hs;

statement error
SELECT * FROM hs.main.users;
----
does not exist

# The id is free again once the registration was redeemed and the catalog detached. Without this, a
# bridge id would be consumed for the life of the process and the source DatabaseInstance would stay
# pinned with it.
statement ok
SELECT bridge_register_source('hs_b', 'memory', 'tok_hs_reuse');

statement ok
SELECT bridge_policy('hs_b', 'main.users', 'select', 'true');

statement ok
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'hs_b', TOKEN 'tok_hs_reuse');

query IT
SELECT * FROM hs.main.users ORDER BY id;
----
1	a
2	b

statement ok
DETACH hs;

# ---------------------------------------------------------------------------
# A granted source schema lands in the target schema of the same name, created by the attach.
# ---------------------------------------------------------------------------

statement ok
CREATE SCHEMA memory.sales;

statement ok
CREATE TABLE memory.sales.orders(id INTEGER PRIMARY KEY, item VARCHAR);

statement ok
INSERT INTO memory.sales.orders VALUES (7, 'widget');

statement ok
SELECT bridge_register_source('hs_multi', 'memory', 'tok_hs_multi');

statement ok
SELECT bridge_policy('hs_multi', 'main.users', 'select', 'true');

statement ok
SELECT bridge_policy('hs_multi', 'sales.orders', 'select', 'true');

# No CREATE SCHEMA hs.sales anywhere above.
statement ok
ATTACH '' AS hs (TYPE virtual_catalog_bridge, ID 'hs_multi', TOKEN 'tok_hs_multi');

query IT
SELECT * FROM hs.sales.orders;
----
7	widget

query TT
SELECT schema, name FROM bridge_table_permissions('hs') ORDER BY schema, name;
----
main	users
sales	orders

# A native entry may be created alongside, into the schema the attach made.
statement ok
CREATE TABLE hs.sales.native(x INTEGER);

statement ok
DETACH hs;

statement error
SELECT * FROM hs.sales.orders;
----
does not exist
