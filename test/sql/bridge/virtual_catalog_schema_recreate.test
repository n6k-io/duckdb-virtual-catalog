# name: test/sql/bridge/virtual_catalog_schema_recreate.test
# description: dropping and recreating a schema must not leave a wrapper bound to the dropped entry
# group: [bridge]

#
# VirtualCatalog::GetOrCreateWrapper caches wrappers by schema name and never invalidates them, and
# VirtualCatalogSchemaEntry holds `target_schema` as a raw reference. After DROP SCHEMA + CREATE
# SCHEMA, LookupSchema returns the wrapper built for the DROPPED DuckSchemaEntry, so the CREATE TABLE
# below forwards into freed memory -- confirmed as a SIGSEGV in
# VirtualCatalogSchemaEntry::LookupEntry under PhysicalPlanGenerator::CreatePlan(LogicalCreateTable)
# when the extension is loaded dynamically. It does not fault in this statically-linked test binary,
# so these assertions only catch the bug under a sanitizer build.

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.anchor(id INTEGER PRIMARY KEY);

statement ok
SELECT bridge_register_source('sr_b', 'memory', 'tok_sr_b');

statement ok
SELECT bridge_policy('sr_b', 'main.anchor', 'select', 'true');

statement ok
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'sr_b', TOKEN 'tok_sr_b');

statement ok
CREATE SCHEMA ws.s;

statement ok
CREATE TABLE ws.s.t(x INTEGER);

statement ok
INSERT INTO ws.s.t VALUES (1);

statement ok
DROP SCHEMA ws.s CASCADE;

statement ok
CREATE SCHEMA ws.s;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'ws' AND schema_name = 's';
----
0

statement ok
CREATE TABLE ws.s.t(y VARCHAR);

statement ok
INSERT INTO ws.s.t VALUES ('new');

query I
SELECT y FROM ws.s.t;
----
new
