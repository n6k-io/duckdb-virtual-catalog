# name: test/sql/bridge/update.test
# description: S6 -- UPDATE carries the key and the new values, under the USING policy.
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.orders(id INTEGER PRIMARY KEY, name VARCHAR, amt INTEGER, tenant INTEGER);

statement ok
INSERT INTO memory.main.orders VALUES (1,'ada',50,7),(2,'grace',150,7),(3,'alan',250,9),(4,'edsger',350,7);

statement ok
SELECT bridge_register_source('v2_update', 'memory', 'tok_update');

statement ok
SELECT bridge_policy('v2_update', 'main.orders', 'select', 'tenant = 7');

statement ok
SELECT bridge_policy('v2_update', 'main.orders', 'update', 'tenant = 7');

statement ok
ATTACH '' AS b (TYPE virtual_catalog_bridge, ID 'v2_update', TOKEN 'tok_update');

statement ok
UPDATE b.main.orders SET amt = 0 WHERE id = 1;

query II
SELECT id, amt FROM memory.main.orders ORDER BY id;
----
1	0
2	150
3	250
4	350

# Several rows at once, and two columns set from one statement.
statement ok
UPDATE b.main.orders SET amt = amt + 1, name = 'bumped' WHERE amt > 100;

query III
SELECT id, name, amt FROM memory.main.orders ORDER BY id;
----
1	ada	0
2	bumped	151
3	alan	250
4	bumped	351

# The hidden row is untouched: it was never reachable to be keyed.
statement ok
UPDATE b.main.orders SET amt = 999;

query II
SELECT id, amt FROM memory.main.orders ORDER BY id;
----
1	999
2	999
3	250
4	999

query I
SELECT count(*) FROM b.main.orders WHERE amt = 999;
----
3
