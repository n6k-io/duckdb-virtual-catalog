# name: test/sql/bridge/vcatbridge_update_default.test
# description: UPDATE ... SET col = DEFAULT on a bridged and on a provider table
# group: [bridge]

require vcatbridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR DEFAULT 'dflt');

statement ok
INSERT INTO memory.main.users VALUES (1, 'a'), (2, 'b');

statement ok
SELECT vcatbridge_register_source('d_b', 'memory', 'tok_d_b');

statement ok
SELECT vcatbridge_set_policy('d_b', 'main.users', v, true) FROM (VALUES ('select'), ('insert'), ('update'), ('delete')) _(v);

statement ok
ATTACH '' AS ws (TYPE vcatbridge, ID 'd_b', TOKEN 'tok_d_b');

# Only the source knows a column's default, and crossing refuses DEFAULT as a value. The row is left as it was.
statement error
UPDATE ws.main.users SET name = DEFAULT WHERE id = 1;
----
DEFAULT itself is not supported

query II
SELECT id, name FROM ws.main.users ORDER BY id;
----
1	a
2	b

# A column with a default on the source stands for it with set_by_source(), which only the source can compute.
query T
SELECT column_default FROM duckdb_columns() WHERE database_name = 'ws' AND column_name = 'name';
----
set_by_source()

statement ok
DETACH ws;
