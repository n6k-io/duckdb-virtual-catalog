# name: test/sql/bridge/virtual_catalog_on_conflict.test
# description: ON CONFLICT on a bridged table, against the source's own unique constraints
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO memory.main.users VALUES (1, 'a'), (2, 'b');

statement ok
SELECT bridge_register_source('oc_b', 'memory', 'tok_oc_b');

statement ok
SELECT bridge_policy('oc_b', 'main.users', v, 'true', c) FROM (VALUES ('select', NULL), ('insert', 'true'), ('update', NULL), ('delete', NULL)) _(v, c);

statement ok
ATTACH '' AS ws (TYPE virtual_catalog_bridge, ID 'oc_b', TOKEN 'tok_oc_b');

# The conflict target comes from the entry's index_info, which reports the unique constraints the
# entry copied from the source. Nothing else is declared unique, so nothing else can be matched on.

query I
INSERT INTO ws.main.users VALUES (1, 'x') ON CONFLICT DO NOTHING;
----
0

query I
INSERT INTO ws.main.users VALUES (2, 'z') ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name;
----
1

query I
INSERT OR REPLACE INTO ws.main.users VALUES (1, 'replaced');
----
1

query I
INSERT OR IGNORE INTO ws.main.users VALUES (2, 'ignored');
----
0

# A row that hits no conflict is appended.
query I
INSERT INTO ws.main.users VALUES (3, 'c') ON CONFLICT DO NOTHING;
----
1

query II
SELECT id, name FROM ws.main.users ORDER BY id;
----
1	replaced
2	z
3	c

# The writes landed on the source, not on a copy.
query II
SELECT id, name FROM memory.main.users ORDER BY id;
----
1	replaced
2	z
3	c

# A column the source does not enforce as unique is not a conflict target.
statement error
INSERT INTO ws.main.users VALUES (4, 'd') ON CONFLICT (name) DO NOTHING;
----
not referenced by a UNIQUE/PRIMARY KEY CONSTRAINT or INDEX

statement ok
DETACH ws;
