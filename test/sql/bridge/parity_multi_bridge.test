# name: test/sql/bridge/parity_multi_bridge.test
# description: several bridges coexist, one attached catalog each.
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO memory.main.users VALUES (1,'ada'),(2,'grace');

statement ok
CREATE TABLE memory.main.logs(id INTEGER PRIMARY KEY, msg VARCHAR);

statement ok
INSERT INTO memory.main.logs VALUES (1,'boot'),(2,'halt');

# First bridge: users only.
statement ok
SELECT bridge_register_source('v2_mb_a', 'memory', 'tok_mb_a');

statement ok
SELECT bridge_policy('v2_mb_a', 'main.users', 'select', 'true');

statement ok
ATTACH '' AS app_a (TYPE virtual_catalog_bridge, ID 'v2_mb_a', TOKEN 'tok_mb_a');

# Second bridge over the same source: logs only, with a policy of its own.
statement ok
SELECT bridge_register_source('v2_mb_b', 'memory', 'tok_mb_b');

statement ok
SELECT bridge_policy('v2_mb_b', 'main.logs', 'select', 'id = 1');

statement ok
ATTACH '' AS app_b (TYPE virtual_catalog_bridge, ID 'v2_mb_b', TOKEN 'tok_mb_b');

# Each catalog holds exactly what its own bridge granted.
query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'app_a' ORDER BY 1;
----
users

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'app_b' ORDER BY 1;
----
logs

# Each table answers through its own bridge, with its own policy.
query I
SELECT count(*) FROM app_a.main.users;
----
2

query I
SELECT count(*) FROM app_b.main.logs;
----
1

# A join across two bridges.
query II
SELECT u.name, l.msg FROM app_a.main.users u JOIN app_b.main.logs l ON u.id = l.id;
----
ada	boot

# A second bridge may serve a table another one already serves: they are separate catalogs, and the
# policies are independent.
statement ok
SELECT bridge_register_source('v2_mb_c', 'memory', 'tok_mb_c');

statement ok
SELECT bridge_policy('v2_mb_c', 'main.users', 'select', 'id = 2');

statement ok
ATTACH '' AS app_c (TYPE virtual_catalog_bridge, ID 'v2_mb_c', TOKEN 'tok_mb_c');

query I
SELECT name FROM app_c.main.users;
----
grace

query I
SELECT count(*) FROM app_a.main.users;
----
2

# Detaching one leaves the others alone.
statement ok
DETACH app_a;

statement error
SELECT * FROM app_a.main.users;
----
<REGEX>:.*(does not exist|no source).*

query I
SELECT count(*) FROM app_b.main.logs;
----
1

query I
SELECT name FROM app_c.main.users;
----
grace
