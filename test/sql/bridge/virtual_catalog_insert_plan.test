# name: test/sql/bridge/virtual_catalog_insert_plan.test
# description: INSERT executes the plan the write fence carries, and that plan is visible to EXPLAIN
# group: [bridge]

require virtual_catalog_bridge

statement ok
CREATE TABLE memory.main.t(id INTEGER PRIMARY KEY, amt INTEGER, note VARCHAR);

statement ok
SELECT bridge_register_source('ins_plan', 'memory', 'tok_ins_plan');

statement ok
SELECT bridge_policy('ins_plan', 'main.t', 'select', 'true');

statement ok
SELECT bridge_policy('ins_plan', 'main.t', 'insert', 'true', 'true');

statement ok
ATTACH '' AS w (TYPE virtual_catalog_bridge, ID 'ins_plan', TOKEN 'tok_ins_plan');

# ---------------------------------------------------------------------------
# EXPLAIN says where the rows are going, and how. A literal VALUES list is rows the target holds, so
# they cross -- but into the seam of the source's own insert, which is one statement rather than one
# per chunk. A feed the source cannot hold renders "rows -> main.t" instead.
# ---------------------------------------------------------------------------

query II
EXPLAIN INSERT INTO w.main.t VALUES (1, 2, 'a');
----
physical_plan	<REGEX>:.*Crossing:.*insert on source.*

# ---------------------------------------------------------------------------
# The plan is executed as a LogicalPlanStatement, which does not register the source as modified on
# its own. Without the explicit ModifyDatabase this commit trips "read-only but has made changes".
# ---------------------------------------------------------------------------

statement ok
BEGIN

statement ok
INSERT INTO w.main.t VALUES (1, 2, 'a');

statement ok
COMMIT

query III
SELECT id, amt, note FROM memory.main.t;
----
1	2	a

# The write resolves with the target's transaction, in both directions.
statement ok
BEGIN

statement ok
INSERT INTO w.main.t VALUES (2, 3, 'b');

statement ok
ROLLBACK

query I
SELECT count(*) FROM memory.main.t;
----
1

statement ok
DETACH w;

# ---------------------------------------------------------------------------
# A check predicate is folded into the plan at build time, so it guards the rows the source binds.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE memory.main.c(id INTEGER PRIMARY KEY, amt INTEGER);

statement ok
SELECT bridge_register_source('ins_check', 'memory', 'tok_ins_check');

statement ok
SELECT bridge_policy('ins_check', 'main.c', 'select', 'true');

statement ok
SELECT bridge_policy('ins_check', 'main.c', 'insert', 'true', 'amt < 100');

statement ok
ATTACH '' AS ck (TYPE virtual_catalog_bridge, ID 'ins_check', TOKEN 'tok_ins_check');

statement error
INSERT INTO ck.main.c VALUES (1, 500);
----
violates the check predicate

statement ok
INSERT INTO ck.main.c VALUES (2, 5);

query II
SELECT id, amt FROM memory.main.c;
----
2	5

statement ok
DETACH ck;
