# name: test/sql/bridge/virtual_catalog_bridge_api.test
# description: pins the registered bridge_% surface against docs/virtual-catalog-bridge.md
# group: [bridge]

require virtual_catalog_bridge

query II
SELECT DISTINCT function_name, len(parameter_types)
FROM duckdb_functions()
WHERE function_name LIKE 'bridge!_%' ESCAPE '!'
ORDER BY 1, 2;
----
bridge_policy	4
bridge_policy	5
bridge_primary_key	3
bridge_primary_key_check	3
bridge_primary_key_query	3
bridge_register_source	2
bridge_register_source	3
bridge_table_describe	3
bridge_table_permissions	3

# Nothing provider-shaped comes with the bridge: the two extensions share no SQL.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name LIKE 'provider!_%' ESCAPE '!';
----
0
