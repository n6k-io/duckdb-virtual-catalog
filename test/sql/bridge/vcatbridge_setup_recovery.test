# name: test/sql/bridge/vcatbridge_setup_recovery.test
# description: an attach refused before redemption must leave the pending source intact
# group: [bridge]

require vcatbridge

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
SELECT vcatbridge_register_source('recv_a', 'memory', 'tok_recv_a');

statement ok
SELECT vcatbridge_set_policy('recv_a', 'main.users', 'select', 'true');

# Every refusal is raised before the pending source is taken, so a bad attach costs the caller
# neither the token nor the grant script.
statement error
ATTACH '' AS ws (TYPE vcatbridge, ID 'recv_a', TOKEN 'not-the-token');
----
invalid setup token

statement error
ATTACH '' AS ws (TYPE vcatbridge, TOKEN 'tok_recv_a');
----
requires a 'id' option

statement error
ATTACH '' AS ws (TYPE vcatbridge, ID 'recv_a', TOKEN '');
----
cannot be empty

statement ok
ATTACH '' AS ws (TYPE vcatbridge, ID 'recv_a', TOKEN 'tok_recv_a');

query I
SELECT count(*) FROM ws.main.users;
----
0

statement ok
DETACH ws;
