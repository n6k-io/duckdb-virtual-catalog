# name: test/sql/n6k_sql_builder.test
# description: n6k_testing_build_*_sql scalars — structure in, SQL out
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[]');
----
Catalog Error

require n6k_testing

# ---------------------------------------------------------------- scan

# No columns and no filters: select everything, no WHERE.
query T
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[]');
----
SELECT * FROM "db"."main"."t"

# Projection is quoted per column.
query T
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '["a","b"]', '[]');
----
SELECT "a", "b" FROM "db"."main"."t"

# Every part of the qualified name is quoted, embedded quotes doubled.
query T
SELECT n6k_testing_build_scan_sql('ca"t', 'we"ird', 'ta"ble', '[]', '[]');
----
SELECT * FROM "ca""t"."we""ird"."ta""ble"

# Top-level filter clauses are AND-joined; string literals are escaped.
query T
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["a",">=",18],["b","=","o''brien"]]');
----
SELECT * FROM "db"."main"."t" WHERE "a" >= 18 AND "b" = 'o''brien'

# A disjunction must survive as one: flattening it into the AND-joined top level
# would silently match nothing.
query T
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["or",[["a",">",5],["a","<",2]]]]');
----
SELECT * FROM "db"."main"."t" WHERE ("a" > 5 OR "a" < 2)

# Null tests and IN.
query T
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["a","is_null",null],["b","in",[1,2]]]');
----
SELECT * FROM "db"."main"."t" WHERE "a" IS NULL AND "b" IN (1, 2)

# `op` is interpolated, so it is whitelisted.
statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["a","; DROP TABLE t --",1]]');
----
unsupported filter operator

statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["nand",[["a","=",1]]]]');
----
unsupported filter group

# Arity is the group/comparison discriminator: anything else is rejected rather
# than truncated to its first three elements.
statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["a","=",1,2]]');
----
malformed filter clause

statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '["a = 1"]');
----
malformed filter clause

statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["or",[]]]');
----
malformed 'or' filter group

statement error
SELECT n6k_testing_build_scan_sql('db', 'main', 't', '[]', '[["a","in",1]]');
----
'in' filter requires a list value

# ---------------------------------------------------------- aggregate

# Group keys first, then aggregates; aliases generated, GROUP BY positional.
query T
SELECT n6k_testing_build_aggregate_sql('db', 'main', 'e', '[]', '["region"]', '[{"fn":"sum","col":"amount"}]');
----
SELECT "region" AS "g0", sum("amount") AS "a0" FROM "db"."main"."e" GROUP BY 1

# count with no column is count(*).
query T
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '[]', '[{"fn":"count"}]');
----
SELECT count(*) AS "a0" FROM "db"."main"."t"

# Multiple keys group positionally, so a key never collides with its own alias.
query T
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '["a","b"]', '[{"fn":"count"}]');
----
SELECT "a" AS "g0", "b" AS "g1", count(*) AS "a0" FROM "db"."main"."t" GROUP BY 1, 2

# WHERE precedes GROUP BY.
query T
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[["ts",">=","2026-01-01"]]', '["r"]', '[{"fn":"count"}]');
----
SELECT "r" AS "g0", count(*) AS "a0" FROM "db"."main"."t" WHERE "ts" >= '2026-01-01' GROUP BY 1

# The contract is positional, so a client-supplied alias is advisory only and
# must never reach the statement.
query T
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '[]', '[{"fn":"count","alias":"\"; DROP TABLE t --"}]');
----
SELECT count(*) AS "a0" FROM "db"."main"."t"

statement error
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '[]', '[{"fn":"median","col":"x"}]');
----
unsupported aggregate function

statement error
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '[]', '[{"fn":"sum"}]');
----
requires a column

statement error
SELECT n6k_testing_build_aggregate_sql('db', 'main', 't', '[]', '[]', '[]');
----
no group keys and no aggregates

# ------------------------------------------------------ create / alter

# Column types are type EXPRESSIONS, interpolated verbatim; only names are quoted.
query T
SELECT n6k_testing_build_create_table_sql('db', 'main', 't', '[{"name":"a","type":"INTEGER"},{"name":"b\"c","type":"VARCHAR"}]');
----
CREATE TABLE "db"."main"."t" ("a" INTEGER, "b""c" VARCHAR)

query T
SELECT n6k_testing_build_alter_sql('db', 'main', 't', 'add_column', '{"name":"a","type":"INTEGER"}');
----
ALTER TABLE "db"."main"."t" ADD COLUMN "a" INTEGER

query T
SELECT n6k_testing_build_alter_sql('db', 'main', 't', 'drop_column', '{"name":"a"}');
----
ALTER TABLE "db"."main"."t" DROP COLUMN "a"

query T
SELECT n6k_testing_build_alter_sql('db', 'main', 't', 'rename_column', '{"old_name":"a\"b","new_name":"c"}');
----
ALTER TABLE "db"."main"."t" RENAME COLUMN "a""b" TO "c"

statement error
SELECT n6k_testing_build_alter_sql('db', 'main', 't', 'drop_table', '{}');
----
unsupported alter kind

# ------------------------------------------------ table_schema / target

query T
SELECT n6k_testing_build_table_schema_sql('db', 'main', 't');
----
SELECT * FROM "db"."main"."t" LIMIT 0

query T
SELECT n6k_testing_qualified_table('db', 'main', 't');
----
"db"."main"."t"

# The scalars are row-wise, not one-shot: a multi-row input builds one statement
# per row.
query T
SELECT n6k_testing_build_table_schema_sql('db', 'main', name) FROM (VALUES ('a'), ('b')) v(name) ORDER BY 1;
----
SELECT * FROM "db"."main"."a" LIMIT 0
SELECT * FROM "db"."main"."b" LIMIT 0
