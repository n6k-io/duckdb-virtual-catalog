# name: test/sql/provider/vcatprovider_api.test
# description: pins the registered vcatprovider_% surface; docs/sql-api.md documents it
# group: [provider]

require vcatprovider

query II
SELECT DISTINCT function_name, len(parameter_types)
FROM duckdb_functions()
WHERE function_name LIKE 'vcatprovider!_%' ESCAPE '!'
ORDER BY 1, 2;
----
vcatprovider_create_stream_function	6
vcatprovider_drop_stream_function	3
vcatprovider_invalidate_tables	1
vcatprovider_register	8
vcatprovider_stream_functions	0
vcatprovider_table_describe	3
vcatprovider_table_permissions	3
vcatprovider_unregister	1

# Nothing bridge-shaped comes with the provider: the two extensions share no SQL.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name LIKE 'vcatbridge!_%' ESCAPE '!';
----
0
