# name: test/sql/provider/virtual_catalog_provider_api.test
# description: pins the registered provider_% surface against docs/virtual-catalog-provider.md
# group: [provider]

require virtual_catalog_provider

query II
SELECT DISTINCT function_name, len(parameter_types)
FROM duckdb_functions()
WHERE function_name LIKE 'provider!_%' ESCAPE '!'
ORDER BY 1, 2;
----
provider_create_stream_function	6
provider_drop_stream_function	3
provider_invalidate_tables	1
provider_register	8
provider_stream_functions	0
provider_table_describe	3
provider_table_permissions	3
provider_unregister	1

# Nothing bridge-shaped comes with the provider: the two extensions share no SQL.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name LIKE 'bridge!_%' ESCAPE '!';
----
0
