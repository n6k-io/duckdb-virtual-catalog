# name: test/sql/virtual_catalog_routing.test
# description: operations route by entry origin inside one virtual_catalog schema
# group: [sql]

require virtual_catalog

statement ok
CREATE TABLE memory.main.users(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO memory.main.users VALUES (1, 'a'), (2, 'b');

statement ok
CREATE TABLE memory.main.logs(id INTEGER PRIMARY KEY, msg VARCHAR);

statement ok
INSERT INTO memory.main.logs VALUES (1, 'boot');

statement ok
ATTACH ':memory:' AS ws (TYPE virtual_catalog);

# Registration order is free: native entries created before the handshake, more after it.
statement ok
CREATE TABLE ws.main.local(x INTEGER PRIMARY KEY, tag VARCHAR);

statement ok
CREATE TABLE tok_ws AS SELECT vcat_register_source('ws_b', 'memory', 'main',
    MAP {'users': 'readwrite', 'logs': 'read'}, MAP {}::MAP(VARCHAR, VARCHAR)) AS t;

statement ok
SELECT vcat_setup_bridge('ws_b', (SELECT t FROM tok_ws), 'ws', 'main');

statement ok
CREATE TABLE ws.main.local2(y INTEGER);

statement ok
CREATE VIEW ws.main.localv AS SELECT 1 AS z;

# ---------------------------------------------------------------------------
# SELECT routes to the entry's own origin; native and bridged entries join.
# ---------------------------------------------------------------------------

statement ok
INSERT INTO ws.main.local VALUES (1, 'first'), (2, 'second');

query IT
SELECT * FROM ws.main.users ORDER BY id;
----
1	a
2	b

query ITT
SELECT u.id, u.name, l.tag FROM ws.main.users u JOIN ws.main.local l ON u.id = l.x ORDER BY u.id;
----
1	a	first
2	b	second

# Tables absent from the permission map are not exposed at all.
statement ok
CREATE TABLE memory.main.secret(id INTEGER PRIMARY KEY);

statement error
SELECT * FROM ws.main.secret;
----
does not exist

# ---------------------------------------------------------------------------
# Writes route to the source and land there, not in the target catalog.
# ---------------------------------------------------------------------------

statement ok
INSERT INTO ws.main.users VALUES (3, 'c');

statement ok
UPDATE ws.main.users SET name = 'z' WHERE id = 1;

statement ok
DELETE FROM ws.main.users WHERE id = 2;

query IT
SELECT * FROM memory.main.users ORDER BY id;
----
1	z
3	c

# Same rows read back through the bridge -- no snapshot, always the source's latest committed data.
query IT
SELECT * FROM ws.main.users ORDER BY id;
----
1	z
3	c

# A READ table is exposed as a view, so all three write paths are refused by the binder. The
# rejection is structural rather than a permission check, and the messages say nothing about the
# bridge -- a client cannot tell this apart from having named an ordinary view.
statement error
INSERT INTO ws.main.logs VALUES (2, 'nope');
----
logs is not an table

statement error
UPDATE ws.main.logs SET msg = 'nope';
----
Can only update base table

statement error
DELETE FROM ws.main.logs WHERE id = 1;
----
Can only delete from base table

# Native entries in the same schema keep full native semantics.
statement ok
UPDATE ws.main.local SET tag = 'edited' WHERE x = 1;

query IT
SELECT * FROM ws.main.local ORDER BY x;
----
1	edited
2	second

# ---------------------------------------------------------------------------
# DDL: rejected on bridge entries, native on native ones.
# ---------------------------------------------------------------------------

statement error
ALTER TABLE ws.main.users ADD COLUMN q INTEGER;
----
bridge-managed; ALTER TABLE is not supported

statement error
DROP TABLE ws.main.users;
----
bridge-managed; DROP is not supported

statement ok
ALTER TABLE ws.main.local ADD COLUMN extra INTEGER;

query I
SELECT len(columns) FROM vcat_table_describe('ws', schema := 'main', "table" := 'local');
----
3

statement ok
DROP TABLE ws.main.local2;

statement ok
DROP VIEW ws.main.localv;

# Transactions are native for native entries.
statement ok
BEGIN;

statement ok
INSERT INTO ws.main.local VALUES (3, 'rolled back', NULL);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM ws.main.local;
----
2

# ---------------------------------------------------------------------------
# Teardown unbinds the bridged names and leaves the native ones alone.
# ---------------------------------------------------------------------------

statement ok
SELECT vcat_unregister_bridge('ws', 'main');

statement error
SELECT * FROM ws.main.users;
----
does not exist

query I
SELECT count(*) FROM ws.main.local;
----
2
