# name: test/sql/virtual_catalog_introspection.test
# description: the published SQL contract -- vcat_table_permissions, vcat_table_describe, vcat_stream_functions
# group: [sql]

require virtual_catalog

statement ok
CREATE TABLE memory.main.src_rw(id INTEGER PRIMARY KEY, name VARCHAR NOT NULL, n INTEGER DEFAULT 5);

statement ok
CREATE TABLE memory.main.src_ro(tenant INTEGER, eid INTEGER, PRIMARY KEY(tenant, eid));

statement ok
ATTACH ':memory:' AS intro (TYPE virtual_catalog);

statement ok
CREATE TABLE intro.main.nat(x INTEGER PRIMARY KEY);

statement ok
CREATE VIEW intro.main.natv AS SELECT 1 AS y;

# Provider UDFs stubbed as macros: list returns the pipe-delimited name set, schema returns NULL so
# no Arrow payload is needed. The capability bits come from which UDF names were registered, not
# from calling them, so this reaches the `provider` row without a host language.
statement ok
CREATE MACRO p_list() AS 'pt';

statement ok
CREATE MACRO p_schema(n) AS NULL::BLOB;

statement ok
SELECT vcat_register_provider('intro', 'main', 'probe', 'p_list', 'p_schema', 'p_scan', 'p_insert', 'p_update', 'p_delete', 'p_alter');

statement ok
CREATE TEMP TABLE tok_intro AS SELECT vcat_register_source('intro_b', 'memory', 'main',
    MAP {'src_rw': 'readwrite', 'src_ro': 'read'}, MAP {}::MAP(VARCHAR, VARCHAR)) AS t;

statement ok
SELECT vcat_setup_bridge('intro_b', (SELECT t FROM tok_intro), 'intro', 'main');

# ---------------------------------------------------------------------------
# Every `kind` in the capability table, coexisting in one schema. This is the
# contract downstream consumers probe for; each cell here is a documented value.
# ---------------------------------------------------------------------------

query TTTTT
SELECT name, kind, writeable, editable, primary_key
FROM vcat_table_permissions('intro', schema := 'main') ORDER BY name;
----
nat	native_table	true	true	[x]
natv	native_view	false	false	[]
pt	provider	true	true	[]
src_ro	bridge_read	false	false	[]
src_rw	bridge_readwrite	true	false	[id]

# Provider capability tracks the registered UDF set: no insert UDF means not writeable, no alter
# UDF means not editable. Re-registering the same (catalog, schema) swaps the UDF set in place.
statement ok
SELECT vcat_register_provider('intro', 'main', 'probe', 'p_list', 'p_schema', 'p_scan', '', '', '', '');

query TTT
SELECT kind, writeable, editable
FROM vcat_table_permissions('intro', schema := 'main', "table" := 'pt');
----
provider	false	false

# Both named filters are case-insensitive.
query TT
SELECT name, kind FROM vcat_table_permissions('intro', schema := 'MAIN', "table" := 'NAT');
----
nat	native_table

# No schema filter: every schema in the catalog.
statement ok
CREATE SCHEMA intro.extra;

statement ok
CREATE TABLE intro.extra.other(z INTEGER);

query TT
SELECT schema, name FROM vcat_table_permissions('intro') ORDER BY schema, name;
----
extra	other
main	nat
main	natv
main	pt
main	src_ro
main	src_rw

# ---------------------------------------------------------------------------
# Plain (non-virtual_catalog) catalogs are classified directly, and a READ_ONLY
# attach overrides the entry's own type -- DuckDB rejects the write at the
# engine level, so reporting it writeable would only let a client find out when
# its write fails.
# ---------------------------------------------------------------------------

query TTTTT
SELECT name, kind, writeable, editable, primary_key
FROM vcat_table_permissions('memory', schema := 'main') ORDER BY name;
----
src_ro	native_table	true	true	[tenant, eid]
src_rw	native_table	true	true	[id]

statement ok
ATTACH '__TEST_DIR__/vcat_intro_ro.db' AS rw;

statement ok
CREATE TABLE rw.main.t(x INTEGER PRIMARY KEY);

statement ok
DETACH rw;

statement ok
ATTACH '__TEST_DIR__/vcat_intro_ro.db' AS ro (READ_ONLY);

query TTTTT
SELECT name, kind, writeable, editable, primary_key
FROM vcat_table_permissions('ro', schema := 'main');
----
t	native_table	false	false	[x]

# ---------------------------------------------------------------------------
# vcat_table_describe: one fully-typed row per table. Capability bits and the
# primary key come from the same collectors as vcat_table_permissions; columns
# and enum domains come from the catalog entry.
# ---------------------------------------------------------------------------

query ITTT
SELECT len(columns), writeable, editable, primary_key
FROM vcat_table_describe('memory', schema := 'main', "table" := 'src_rw');
----
3	true	true	[id]

query TTTT
SELECT c.name, c.type, c.nullable, c."default"
FROM vcat_table_describe('memory', schema := 'main', "table" := 'src_rw') t, UNNEST(t.columns) AS u(c)
ORDER BY c.name;
----
id	INTEGER	false	NULL
n	INTEGER	true	5
name	VARCHAR	false	NULL

# A view is neither writeable nor editable, and its columns come from binding it.
query ITT
SELECT len(columns), writeable, editable
FROM vcat_table_describe('intro', schema := 'main', "table" := 'natv');
----
1	false	false

# A bridged readwrite table describes with the bridge's capability bits and discovered key.
query ITTT
SELECT len(columns), writeable, editable, primary_key
FROM vcat_table_describe('intro', schema := 'main', "table" := 'src_rw');
----
3	true	false	[id]

# Enum domains are reported per column so a client does not need enum_range().
statement ok
CREATE TYPE mood AS ENUM ('ok', 'sad');

statement ok
CREATE TABLE memory.main.with_enum(id INTEGER PRIMARY KEY, m mood);

query T
SELECT enums['m'] FROM vcat_table_describe('memory', schema := 'main', "table" := 'with_enum');
----
[ok, sad]

statement error
SELECT * FROM vcat_table_describe('memory', schema := 'main', "table" := 'nope');
----
not found

# The "table" argument is required -- describe is single-table by construction.
statement error
SELECT * FROM vcat_table_describe('memory', schema := 'main');
----
requires a "table" argument

# ---------------------------------------------------------------------------
# vcat_stream_functions: registration is visible, drop removes it.
# ---------------------------------------------------------------------------

statement ok
SELECT vcat_create_stream_function('intro', 'main', 'gen', 'gen_open', 'gen_next', 'gen_close');

query TTTTTT
SELECT schema, entry_name, function_name, open_udf, next_udf, close_udf
FROM vcat_stream_functions() WHERE catalog = 'intro' ORDER BY entry_name;
----
main	gen	gen	gen_open	gen_next	gen_close

statement ok
SELECT vcat_drop_stream_function('intro', 'main', 'gen');

query I
SELECT count(*) FROM vcat_stream_functions() WHERE catalog = 'intro';
----
0

statement ok
SELECT vcat_unregister_bridge('intro', 'main');

statement ok
SELECT vcat_unregister_provider('intro', 'main');
